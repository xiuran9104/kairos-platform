# PostgreSQL 数据库连接
DATABASE_URL=postgres://kairos_platform:kairos_platform@localhost:5432/kairos_platform

# JWT 密钥
JWT_SECRET=kairos-platform-local-dev-secret-key-2026

# 服务端口
GATEWAY_PORT=8080

# Redis (可选，不配则跳过缓存和限流)
# REDIS_URL=redis://localhost:6379

# 本机隔离靶场开发模式；以后生产部署时改为 PENTA_ENV=production
PENTA_ENV=development
PENTA_ALLOW_DIRECT_NETWORK_TOOLS=true
PENTA_AUTO_APPROVE_ALL_TOOLS=true
PENTA_CONTEXT_TOKEN_BUDGET=12000
PENTA_CONVERSATION_MAX_OUTPUT_TOKENS=16000
PENTA_UNLIMITED_BUDGETS=true
PENTA_REQUIRE_IMAGE_DIGEST=false
PENTA_DOCKER_TARGET_NETWORK=host
PENTA_TOOLKIT_IMAGE=kairos-platform/pent-toolkit:kali-2026.1
PENTA_DOCKER_TOOL_NETWORK=host

# MCP 工具链 — 浏览器自动化（chrome-devtools 通过 npx 启动）
# JSON 单行数组，PENTA_MCP_SERVERS='[{"id":"chrome-devtools","command":"npx","args":["-y","chrome-devtools-mcp","-u","http://localhost:9222","--headless","--no-usage-statistics"],"env":{},"auto_start":true}]'
PENTA_MCP_SERVERS='[{"id":"chrome-devtools","command":"npx","args":["-y","chrome-devtools-mcp","-u","http://localhost:9222","--headless","--no-usage-statistics"],"env":{},"auto_start":true}]'

# 本地工具
PENTA_LOCAL_TOOLS_ENABLED=true
PENTA_LOCAL_TOOLS_ALLOWED_ROOTS=/home
PENTA_SEARCH_ENDPOINT=https://api.duckduckgo.com/

# M2: mitmproxy traffic capture
PENTA_TRAFFIC_CAPTURE=true
PENTA_TRAFFIC_PROXY=http://127.0.0.1:8085
# M2: AUP skip for dev
PENTA_SKIP_AUP=true
